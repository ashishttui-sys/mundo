<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="#0F0F15">

    <!-- SAFE LOADER Top Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="28dp"
        android:text=""
        android:textColor="#0070C8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Header Area -->
    <LinearLayout
        android:id="@+id/headerArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo - FIXED: padding 0 for full fit -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="85dp"
            android:layout_height="85dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1A1A2E"
            app:strokeColor="#333"
            app:strokeWidth="1dp">
            
            <ImageView
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher"
                android:id="@+id/logo"
                android:padding="0dp"
                android:layout_margin="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Brand Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tapatap Loader"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#999"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Login Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loginCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="45dp"
        android:layout_below="@id/headerArea"
        app:cardBackgroundColor="#CC14141E"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:strokeColor="#2A2A3A"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Field Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your licence key"
                android:textColor="#BBB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Input Field -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cardBackgroundColor="#0F0F18"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <!-- Lock Icon -->
                    <ImageView
                        android:layout_height="20dp"
                        android:layout_width="20dp"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        android:tint="#0070C8"
                        android:layout_marginEnd="10dp" />

                    <EditText
                        android:layout_height="match_parent"
                        android:layout_width="0dp"
                        android:background="@android:color/transparent"
                        android:hint="Enter your licence key"
                        android:textColorHint="#555"
                        android:textColor="#FFF"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:inputType="textPassword"
                        android:id="@+id/userkey" />

                    <!-- Paste Icon - FIXED: same size as lock 20dp -->
                    <ImageView
                        android:layout_height="20dp"
                        android:layout_width="20dp"
                        android:src="@drawable/ic_content_paste"
                        android:tint="#0070C8"
                        android:id="@+id/paste"
                        android:padding="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Login Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#0070C8"
                app:cardCornerRadius="12dp"
                app:cardElevation="5dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:text="Sign In"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- Help Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Need help? Contact Owner"
                android:textColor="#666"
                android:textSize="11sp" />

            <!-- Hidden -->
            <TextView
                android:layout_height="0dp"
                android:layout_width="0dp"
                android:id="@+id/GetKey"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Footer -->
    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="25dp"
        android:textColor="#444"
        android:id="@+id/footer"
        android:text=""
        android:textSize="10sp" />

</RelativeLayout>